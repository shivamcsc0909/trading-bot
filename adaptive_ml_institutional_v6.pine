//@version=5
indicator("Adaptive ML & Regime Engine [Gold & Forex] - Ultra Clean", overlay=true, max_lines_count=500, max_labels_count=500)

// =============================================================================
// 1. INPUT SETTINGS
// =============================================================================
grp_engine   = "🤖 Machine Learning & Adaptive Engine"
knn_k        = input.int(7, "KNN Neighbors (k)", minval=3, maxval=15, group=grp_engine)
knn_lookback = input.int(60, "ML Memory Lookback Bars", minval=20, maxval=150, group=grp_engine)
regime_len   = input.int(20, "Regime Detection Period", minval=10, maxval=50, group=grp_engine)
use_ml_adapt = input.bool(true, "Enable Auto-Adaptive Strategy Switching", group=grp_engine)

grp_trend    = "📈 Trend Baseline"
fast_ema_len = input.int(9, "Fast EMA", minval=3, group=grp_trend)
mid_ema_len  = input.int(21, "Mid EMA", minval=8, group=grp_trend)
slow_ema_len = input.int(50, "Slow EMA", minval=20, group=grp_trend)

grp_vol      = "🌊 Volatility & Risk Management"
atr_len      = input.int(14, "ATR Length", minval=5, group=grp_vol)
atr_mult     = input.float(2.0, "ATR Stop Multiplier", minval=0.5, step=0.1, group=grp_vol)
tp1_mult     = input.float(2.0, "TP1 Multiplier (R:R)", minval=1.0, step=0.5, group=grp_vol)
tp2_mult     = input.float(3.5, "TP2 Multiplier (R:R)", minval=1.5, step=0.5, group=grp_vol)
tp3_mult     = input.float(5.0, "TP3 Multiplier (R:R)", minval=2.0, step=0.5, group=grp_vol)

grp_gold     = "🥇 Gold (XAUUSD) Modulo 100-Block"
mod_step     = input.float(10.0, "Modulo Step ($10 for Gold)", step=1.0, group=grp_gold)
show_table   = input.bool(true, "Show Multi-Factor ML Table", group=grp_engine)

// =============================================================================
// 2. TECHNICAL INDICATORS
// =============================================================================
// Moving Averages
ema_fast = ta.ema(close, fast_ema_len)
ema_mid  = ta.ema(close, mid_ema_len)
ema_slow = ta.ema(close, slow_ema_len)

is_ema_bull = (ema_fast > ema_mid) and (ema_mid > ema_slow)
is_ema_bear = (ema_fast < ema_mid) and (ema_mid < ema_slow)

// ATR Volatility
atr_val    = ta.atr(atr_len)
upper_band = close + (atr_val * 1.5)
lower_band = close - (atr_val * 1.5)

// Dual RSI Momentum
rsi_fast = ta.rsi(close, 25)
rsi_slow = ta.rsi(close, 100)
rsi_bull = rsi_fast > rsi_slow
rsi_bear = rsi_fast < rsi_slow

// Volume Delta Flow
float c_minus_l = close - low
float h_minus_c = high - close
float candle_rng = high - low
float vol_up = candle_rng > 0 ? volume * (c_minus_l / candle_rng) : volume * 0.5
float vol_down = candle_rng > 0 ? volume * (h_minus_c / candle_rng) : volume * 0.5
float vol_delta = vol_up - vol_down
float delta_sma = ta.sma(vol_delta, 10)
bool delta_bull = vol_delta > delta_sma
bool delta_bear = vol_delta < delta_sma

// Modulo 100-Block Zone
float curr_mod = math.floor(close / mod_step) * mod_step
float dist_to_base = close - curr_mod
bool is_mod_support    = dist_to_base <= (mod_step * 0.15)
bool is_mod_resistance = dist_to_base >= (mod_step * 0.85)

// =============================================================================
// 3. REGIME CLASSIFICATION
// =============================================================================
[di_p, di_m, adx_val] = ta.dmi(14, 14)
float bb_basis = ta.sma(close, regime_len)
float bb_dev   = 2.0 * ta.stdev(close, regime_len)
float bb_upper = bb_basis + bb_dev
float bb_lower = bb_basis - bb_dev
float bb_width = bb_basis > 0 ? (bb_upper - bb_lower) / bb_basis : 0.0

var int market_regime = 3
string regime_str = "RANGING"
color regime_color = color.gray

if (adx_val >= 25) and is_ema_bull
    market_regime := 1
    regime_str := "TREND BULL"
    regime_color := color.green
else if (adx_val >= 25) and is_ema_bear
    market_regime := 2
    regime_str := "TREND BEAR"
    regime_color := color.red
else if bb_width > (ta.sma(bb_width, 50) * 1.3)
    market_regime := 4
    regime_str := "EXPANSION"
    regime_color := color.orange
else
    market_regime := 3
    regime_str := "RANGING"
    regime_color := color.purple

// =============================================================================
// 4. KNN MACHINE LEARNING ENGINE
// =============================================================================
float f1 = math.min(math.max(nz(rsi_fast, 50.0) / 100.0, 0.0), 1.0)
float f2 = math.min(math.max((nz(atr_val, 1.0) / math.max(close, 1.0)) * 100.0, 0.0), 1.0)
float f3 = math.min(math.max((ta.roc(close, 10) + 5.0) / 10.0, 0.0), 1.0)

var mem_f1  = array.new_float(0)
var mem_f2  = array.new_float(0)
var mem_f3  = array.new_float(0)
var mem_lbl = array.new_int(0)

if bar_index > 10
    float past_ret = (close - close[4]) / close[4]
    int past_outcome = past_ret > 0.001 ? 1 : (past_ret < -0.001 ? -1 : 0)
    
    array.push(mem_f1, nz(f1[4], 0.5))
    array.push(mem_f2, nz(f2[4], 0.5))
    array.push(mem_f3, nz(f3[4], 0.5))
    array.push(mem_lbl, past_outcome)
    
    if array.size(mem_f1) > knn_lookback
        array.shift(mem_f1)
        array.shift(mem_f2)
        array.shift(mem_f3)
        array.shift(mem_lbl)

int knn_votes_bull = 0
int knn_votes_bear = 0

int mem_sz = array.size(mem_f1)
if mem_sz >= knn_k
    var dists = array.new_float(0)
    var lbls  = array.new_int(0)
    array.clear(dists)
    array.clear(lbls)
    
    for i = 0 to mem_sz - 1
        float df1 = f1 - array.get(mem_f1, i)
        float df2 = f2 - array.get(mem_f2, i)
        float df3 = f3 - array.get(mem_f3, i)
        float d = math.sqrt(df1 * df1 + df2 * df2 + df3 * df3)
        array.push(dists, d)
        array.push(lbls, array.get(mem_lbl, i))
    
    for k_idx = 1 to knn_k
        float min_d = 999999.0
        int min_idx = 0
        int d_sz = array.size(dists)
        for j = 0 to d_sz - 1
            float curr_d = array.get(dists, j)
            if curr_d < min_d
                min_d := curr_d
                min_idx := j
        
        int vote = array.get(lbls, min_idx)
        if vote == 1
            knn_votes_bull += 1
        else if vote == -1
            knn_votes_bear += 1
        
        array.set(dists, min_idx, 999999.0)

float ml_confidence = mem_sz >= knn_k ? (math.max(knn_votes_bull, knn_votes_bear) / float(knn_k)) * 100.0 : 50.0
bool ml_bull_pred  = (knn_votes_bull > knn_votes_bear) and (ml_confidence >= 55.0)
bool ml_bear_pred  = (knn_votes_bear > knn_votes_bull) and (ml_confidence >= 55.0)

// =============================================================================
// 5. AUTO-ADAPTIVE STRATEGY SWITCHING
// =============================================================================
bool buy_signal  = false
bool sell_signal = false
string active_strategy = "STANDBY"

if use_ml_adapt
    if market_regime == 1
        active_strategy := "TREND RIDER"
        if ml_bull_pred and rsi_bull and delta_bull and (close > ema_mid) and (low <= ema_mid * 1.002)
            buy_signal := true
            
    else if market_regime == 2
        active_strategy := "TREND RIDER"
        if ml_bear_pred and rsi_bear and delta_bear and (close < ema_mid) and (high >= ema_mid * 0.998)
            sell_signal := true
            
    else if market_regime == 3
        active_strategy := "MEAN REVERSION"
        if (open < lower_band or is_mod_support) and ml_bull_pred and (rsi_fast < 50)
            buy_signal := true
        else if (open > upper_band or is_mod_resistance) and ml_bear_pred and (rsi_fast > 50)
            sell_signal := true
            
    else if market_regime == 4
        active_strategy := "BREAKOUT"
        if (close > ta.highest(high, 15)[1]) and delta_bull and ml_bull_pred
            buy_signal := true
        else if (close < ta.lowest(low, 15)[1]) and delta_bear and ml_bear_pred
            sell_signal := true
else
    if is_ema_bull and rsi_bull and delta_bull and ml_bull_pred
        buy_signal := true
    else if is_ema_bear and rsi_bear and delta_bear and ml_bear_pred
        sell_signal := true

var int last_signal_bar = 0
if (buy_signal or sell_signal) and (bar_index - last_signal_bar < 3)
    buy_signal  := false
    sell_signal := false

if buy_signal or sell_signal
    last_signal_bar := bar_index

// =============================================================================
// 6. TARGET LEVELS & VISUALS
// =============================================================================
var int block_nonce = 0
if buy_signal or sell_signal
    block_nonce += 1

var float sig_entry = 0.0
var float sig_sl    = 0.0
var float sig_tp1   = 0.0
var float sig_tp2   = 0.0
var float sig_tp3   = 0.0

if buy_signal
    sig_entry := close
    float sl_dist = atr_val * atr_mult
    sig_sl    := close - sl_dist
    sig_tp1   := close + (sl_dist * tp1_mult)
    sig_tp2   := close + (sl_dist * tp2_mult)
    sig_tp3   := close + (sl_dist * tp3_mult)
    
    string lbl_text = "⚡ BUY (" + active_strategy + ")\nConf: " + str.tostring(math.round(ml_confidence)) + "%\nEntry: " + str.tostring(sig_entry, "#.##") + "\nSL: " + str.tostring(sig_sl, "#.##") + "\nTP1: " + str.tostring(sig_tp1, "#.##") + "\nTP2: " + str.tostring(sig_tp2, "#.##") + "\nTP3: " + str.tostring(sig_tp3, "#.##")
    label.new(bar_index, low - (atr_val * 0.5), text=lbl_text, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    alert("BUY Signal Triggered", alert.freq_once_per_bar_close)

if sell_signal
    sig_entry := close
    float sl_dist = atr_val * atr_mult
    sig_sl    := close + sl_dist
    sig_tp1   := close - (sl_dist * tp1_mult)
    sig_tp2   := close - (sl_dist * tp2_mult)
    sig_tp3   := close - (sl_dist * tp3_mult)
    
    string lbl_text = "⚡ SELL (" + active_strategy + ")\nConf: " + str.tostring(math.round(ml_confidence)) + "%\nEntry: " + str.tostring(sig_entry, "#.##") + "\nSL: " + str.tostring(sig_sl, "#.##") + "\nTP1: " + str.tostring(sig_tp1, "#.##") + "\nTP2: " + str.tostring(sig_tp2, "#.##") + "\nTP3: " + str.tostring(sig_tp3, "#.##")
    label.new(bar_index, high + (atr_val * 0.5), text=lbl_text, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    alert("SELL Signal Triggered", alert.freq_once_per_bar_close)

// Plot EMAs
plot(ema_fast, "EMA 9 Fast", color=color.blue, width=1)
plot(ema_mid,  "EMA 21 Mid",  color=color.yellow, width=2)
plot(ema_slow, "EMA 50 Slow", color=color.purple, width=2)

// =============================================================================
// 7. MULTI-FACTOR HUD DASHBOARD TABLE
// =============================================================================
var table hud_table = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)

if show_table and barstate.islast
    table.cell(hud_table, 0, 0, "🤖 ADAPTIVE ML ENGINE", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 0, "STATUS", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(hud_table, 0, 1, "Market Regime", text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 1, regime_str, bgcolor=regime_color, text_color=color.white, text_size=size.small)
    
    table.cell(hud_table, 0, 2, "Active Strategy", text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 2, active_strategy, text_color=color.yellow, text_size=size.small)
    
    table.cell(hud_table, 0, 3, "KNN Confidence", text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 3, str.tostring(math.round(ml_confidence, 1)) + "%", text_color=ml_confidence >= 60 ? color.green : color.orange, text_size=size.small)
    
    table.cell(hud_table, 0, 4, "Triple EMA Stack", text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 4, is_ema_bull ? "BULLISH" : (is_ema_bear ? "BEARISH" : "MIXED"), text_color=is_ema_bull ? color.green : (is_ema_bear ? color.red : color.gray), text_size=size.small)
    
    table.cell(hud_table, 0, 5, "Volume Delta", text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 5, vol_delta > 0 ? "BUYERS DOMINATING" : "SELLERS DOMINATING", text_color=vol_delta > 0 ? color.green : color.red, text_size=size.small)
    
    table.cell(hud_table, 0, 6, "Gold Modulo Zone", text_color=color.white, text_size=size.small)
    table.cell(hud_table, 1, 6, "$" + str.tostring(curr_mod, "#") + " Zone", text_color=color.aqua, text_size=size.small)

// Alert Conditions for TradingView UI
alertcondition(buy_signal,  title="Adaptive ML BUY Signal",  message="BUY Signal Triggered")
alertcondition(sell_signal, title="Adaptive ML SELL Signal", message="SELL Signal Triggered")
