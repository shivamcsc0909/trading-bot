//@version=6
indicator("Institutional Multi-Factor Engine [v6]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =============================================================================
// 1. SYSTEM CONFIGURATION & INPUTS
// =============================================================================
grp_gen      = "⚙️ General & Instrument Profile"
sym_profile  = input.string("Auto (From Symbol)", "Instrument Profile", options=["Auto (From Symbol)", "XAUUSD (Gold)", "EURUSD", "GBPUSD", "Custom"], group=grp_gen)
min_score    = input.int(70, "Minimum Confluence Score (0-100)", minval=50, maxval=95, group=grp_gen)
exec_tf_only = input.bool(true, "Execute on Confirmed Bar Close Only", group=grp_gen)

grp_mtf      = "⏱️ Multi-Timeframe Context"
htf_tf       = input.timeframe("60", "Higher Timeframe (HTF)", group=grp_mtf)
mtf_tf       = input.timeframe("15", "Middle Timeframe (MTF)", group=grp_mtf)
use_mtf_conf = input.bool(true, "Require HTF/MTF Alignment", group=grp_mtf)

grp_trend    = "📈 Trend Baseline & Moving Averages"
use_trend    = input.bool(true, "Enable Trend Engine", group=grp_trend)
ema_fast_len = input.int(9, "Fast EMA", minval=3, group=grp_trend)
ema_mid_len  = input.int(21, "Mid EMA", minval=8, group=grp_trend)
ema_slow_len = input.int(50, "Slow EMA", minval=20, group=grp_trend)

grp_mom      = "⚡ Momentum Engine"
use_mom      = input.bool(true, "Enable Momentum Engine", group=grp_mom)
rsi_fast_len = input.int(25, "Fast RSI Length (Gold=25, FX=14)", minval=5, group=grp_mom)
rsi_slow_len = input.int(100, "Slow RSI Length (Gold=100, FX=50)", minval=20, group=grp_mom)
roc_len      = input.int(10, "ROC Momentum Period", minval=3, group=grp_mom)

grp_vol      = "🌊 Volatility & Risk Engine"
atr_len      = input.int(14, "ATR Length", minval=5, group=grp_vol)
atr_sl_mult  = input.float(2.0, "ATR Stop Loss Multiplier", minval=0.5, step=0.1, group=grp_vol)
tp1_mult     = input.float(2.0, "TP1 Multiplier (R:R)", minval=1.0, step=0.5, group=grp_vol)
tp2_mult     = input.float(3.5, "TP2 Multiplier (R:R)", minval=1.5, step=0.5, group=grp_vol)
tp3_mult     = input.float(5.0, "TP3 Multiplier (R:R)", minval=2.0, step=0.5, group=grp_vol)

grp_struct   = "🏛️ Market Structure & Smart Money"
use_struct   = input.bool(true, "Enable Structure & Pivots", group=grp_struct)
pivot_len    = input.int(5, "Pivot Confirmation Length", minval=2, maxval=15, group=grp_struct)
use_fvg      = input.bool(true, "Enable Fair Value Gaps (FVG)", group=grp_struct)
fvg_min_pts  = input.float(0.5, "Min FVG Size (Points / Pips)", step=0.1, group=grp_struct)

grp_ml       = "🤖 Adaptive Pattern & KNN Engine"
use_knn      = input.bool(true, "Enable KNN-Style Adaptive Pattern Scoring", group=grp_ml)
knn_k        = input.int(7, "KNN Neighbors (k)", minval=3, maxval=15, group=grp_ml)
knn_memory   = input.int(80, "Rolling Pattern Memory Size", minval=30, maxval=150, group=grp_ml)

grp_gold     = "🥇 Gold (XAUUSD) Modulo 100-Block"
use_modulo   = input.bool(true, "Enable Modulo Psychological Levels", group=grp_gold)
mod_step     = input.float(10.0, "Modulo Step ($10 for Gold / 100 pips)", step=1.0, group=grp_gold)

grp_ui       = "🖥️ Visuals & HUD Table"
show_table   = input.bool(true, "Display Performance & Confluence Dashboard", group=grp_ui)
show_ribbon  = input.bool(true, "Show EMA Ribbon", group=grp_ui)

// =============================================================================
// 2. DATA STRUCTURES (UDT)
// =============================================================================
type MarketFeatures
    float f_rsi
    float f_atr
    float f_roc
    float f_vol_delta
    float f_ema_dist

type ConfluenceScore
    int total_buy
    int total_sell
    string bias
    string quality
    string active_strategy

// =============================================================================
// 3. MULTI-TIMEFRAME & TREND CALCULATION (NON-REPAINTING)
// =============================================================================
// Safe Non-Repainting Security Wrapper
f_get_confirmed_ema(string tf, int len) =>
    request.security(syminfo.tickerid, tf, ta.ema(close[1], len), barmerge.gaps_off, barmerge.lookahead_off)

// Current Timeframe EMAs
ema_fast = ta.ema(close, ema_fast_len)
ema_mid  = ta.ema(close, ema_mid_len)
ema_slow = ta.ema(close, slow_ema_len)

bool is_trend_bull = (ema_fast > ema_mid) and (ema_mid > ema_slow)
bool is_trend_bear = (ema_fast < ema_mid) and (ema_mid < ema_slow)

// Higher Timeframe Alignment
htf_ema_fast = f_get_confirmed_ema(htf_tf, ema_fast_len)
htf_ema_slow = f_get_confirmed_ema(htf_tf, slow_ema_len)
bool htf_bull = htf_ema_fast > htf_ema_slow
bool htf_bear = htf_ema_fast < htf_ema_slow

// =============================================================================
// 4. MOMENTUM, VOLATILITY & VOLUME PRESSURE
// =============================================================================
// Dual RSI
rsi_fast = ta.rsi(close, rsi_fast_len)
rsi_slow = ta.rsi(close, rsi_slow_len)
bool rsi_bull = rsi_fast > rsi_slow
bool rsi_bear = rsi_fast < rsi_slow

// Rate of Change & Slope
roc_val = ta.roc(close, roc_len)
ema_slope = (ema_mid - ema_mid[3]) / 3.0

// ATR & Volatility Envelopes
atr_val    = ta.atr(atr_len)
atr_ma     = ta.sma(atr_val, 30)
upper_band = close + (atr_val * 1.5)
lower_band = close - (atr_val * 1.5)

// Bollinger Band Width for Regime Detection
bb_basis = ta.sma(close, 20)
bb_dev   = 2.0 * ta.stdev(close, 20)
bb_width = bb_basis > 0 ? ((bb_basis + bb_dev) - (bb_basis - bb_dev)) / bb_basis : 0.0

// Volume Pressure Approximation (Normalized)
float candle_range = high - low
float vol_up   = candle_range > 0 ? volume * ((close - low) / candle_range) : volume * 0.5
float vol_down = candle_range > 0 ? volume * ((high - close) / candle_range) : volume * 0.5
float vol_delta = vol_up - vol_down
float delta_ma  = ta.sma(vol_delta, 10)
bool delta_bull = vol_delta > delta_ma
bool delta_bear = vol_delta < delta_ma

// =============================================================================
// 5. STRUCTURE, FVG & PSYCHOLOGICAL LEVELS
// =============================================================================
// Confirmed Pivots (Zero Lookahead on confirmed bars)
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

var float last_swing_high = na
var float last_swing_low  = na

if not na(ph)
    last_swing_high := ph
if not na(pl)
    last_swing_low  := pl

bool bos_bull = close > last_swing_high
bool bos_bear = close < last_swing_low

// 3-Candle Fair Value Gap (FVG)
bool bull_fvg = (low > high[2]) and ((low - high[2]) >= fvg_min_pts)
bool bear_fvg = (high < low[2]) and ((low[2] - high) >= fvg_min_pts)

// Modulo 100-Block Psychological Round Zones
float curr_mod      = math.floor(close / mod_step) * mod_step
float dist_to_block = close - curr_mod
bool is_mod_floor   = dist_to_block <= (mod_step * 0.15)
bool is_mod_ceil    = dist_to_block >= (mod_step * 0.85)

// =============================================================================
// 6. MARKET REGIME DETECTION & STRATEGY SELECTOR
// =============================================================================
[di_p, di_m, adx_val] = ta.dmi(14, 14)

var int market_regime = 3 // 1=Trend Bull, 2=Trend Bear, 3=Range, 4=Expansion, 5=Extreme
string regime_str = "RANGING"
color regime_col  = color.purple

bool is_extreme_vol = atr_val > (atr_ma * 2.5)

if is_extreme_vol
    market_regime := 5
    regime_str    := "EXTREME / NO TRADE"
    regime_col    := color.maroon
else if (adx_val >= 22) and is_trend_bull and (ema_slope > 0)
    market_regime := 1
    regime_str    := "TREND BULL"
    regime_col    := color.green
else if (adx_val >= 22) and is_trend_bear and (ema_slope < 0)
    market_regime := 2
    regime_str    := "TREND BEAR"
    regime_col    := color.red
else if bb_width > (ta.sma(bb_width, 50) * 1.3)
    market_regime := 4
    regime_str    := "EXPANSION"
    regime_col    := color.orange
else
    market_regime := 3
    regime_str    := "RANGING"
    regime_col    := color.purple

// =============================================================================
// 7. KNN-STYLE ADAPTIVE PATTERN ENGINE
// =============================================================================
f_rsi = math.min(math.max(nz(rsi_fast, 50.0) / 100.0, 0.0), 1.0)
f_atr = math.min(math.max((nz(atr_val, 1.0) / math.max(close, 1.0)) * 100.0, 0.0), 1.0)
f_roc = math.min(math.max((nz(roc_val, 0.0) + 5.0) / 10.0, 0.0), 1.0)
f_del = math.min(math.max(delta_bull ? 1.0 : 0.0, 0.0), 1.0)

var mem_f1  = array.new_float(0)
var mem_f2  = array.new_float(0)
var mem_f3  = array.new_float(0)
var mem_f4  = array.new_float(0)
var mem_lbl = array.new_int(0)

// Register historical observation at bar index t-4 (Strict Zero Lookahead)
if bar_index > 15
    float past_ret = (close - close[4]) / close[4]
    int past_out = past_ret > 0.001 ? 1 : (past_ret < -0.001 ? -1 : 0)
    
    array.push(mem_f1, nz(f_rsi[4], 0.5))
    array.push(mem_f2, nz(f_atr[4], 0.5))
    array.push(mem_f3, nz(f_roc[4], 0.5))
    array.push(mem_f4, nz(f_del[4], 0.5))
    array.push(mem_lbl, past_out)
    
    if array.size(mem_f1) > knn_memory
        array.shift(mem_f1)
        array.shift(mem_f2)
        array.shift(mem_f3)
        array.shift(mem_f4)
        array.shift(mem_lbl)

int knn_votes_bull = 0
int knn_votes_bear = 0
int mem_sz = array.size(mem_f1)

if use_knn and (mem_sz >= knn_k)
    var dists = array.new_float(0)
    var lbls  = array.new_int(0)
    array.clear(dists)
    array.clear(lbls)
    
    for i = 0 to mem_sz - 1
        float d1 = f_rsi - array.get(mem_f1, i)
        float d2 = f_atr - array.get(mem_f2, i)
        float d3 = f_roc - array.get(mem_f3, i)
        float d4 = f_del - array.get(mem_f4, i)
        float dist = math.sqrt(d1*d1 + d2*d2 + d3*d3 + d4*d4)
        array.push(dists, dist)
        array.push(lbls, array.get(mem_lbl, i))
        
    for k_idx = 1 to knn_k
        float min_d = 999999.0
        int min_idx = 0
        int d_sz = array.size(dists)
        for j = 0 to d_sz - 1
            float cd = array.get(dists, j)
            if cd < min_d
                min_d := cd
                min_idx := j
        
        int vote = array.get(lbls, min_idx)
        if vote == 1
            knn_votes_bull += 1
        else if vote == -1
            knn_votes_bear += 1
        
        array.set(dists, min_idx, 999999.0)

float knn_confidence = mem_sz >= knn_k ? (math.max(knn_votes_bull, knn_votes_bear) / float(knn_k)) * 100.0 : 50.0
bool knn_bull_pred = (knn_votes_bull > knn_votes_bear) and (knn_confidence >= 55.0)
bool knn_bear_pred = (knn_votes_bear > knn_votes_bull) and (knn_confidence >= 55.0)

// =============================================================================
// 8. CONFLUENCE SCORING & WEIGHTED ARBITER
// =============================================================================
int buy_score  = 0
int sell_score = 0

// Trend Alignment (15 pts)
if is_trend_bull
    buy_score += 15
if is_trend_bear
    sell_score += 15

// HTF Confirmation (10 pts)
if htf_bull
    buy_score += 10
if htf_bear
    sell_score += 10

// Momentum & RSI (15 pts)
if rsi_bull and (roc_val > 0)
    buy_score += 15
if rsi_bear and (roc_val < 0)
    sell_score += 15

// Volume Pressure (10 pts)
if delta_bull
    buy_score += 10
if delta_bear
    sell_score += 10

// Market Structure / BOS (15 pts)
if bos_bull or (close > ema_mid and low <= ema_mid * 1.001)
    buy_score += 15
if bos_bear or (close < ema_mid and high >= ema_mid * 0.999)
    sell_score += 15

// FVG & Modulo Confluence (15 pts)
if bull_fvg or is_mod_floor
    buy_score += 15
if bear_fvg or is_mod_ceil
    sell_score += 15

// KNN Adaptive ML Pattern (10 pts)
if knn_bull_pred
    buy_score += 10
if knn_bear_pred
    sell_score += 10

// Strategy Selection
string active_strat = "STANDBY"
if market_regime == 1 or market_regime == 2
    active_strat := "TREND RIDER"
else if market_regime == 3
    active_strat := "MEAN REVERSION"
else if market_regime == 4
    active_strat := "BREAKOUT"
else
    active_strat := "NO TRADE"

// Signal Quality Classification
string signal_qual = "NO TRADE"
int dominant_score = math.max(buy_score, sell_score)
if dominant_score >= 85
    signal_qual := "A+ INSTITUTIONAL"
else if dominant_score >= 75
    signal_qual := "A STRONG"
else if dominant_score >= min_score
    signal_qual := "B MODERATE"
else
    signal_qual := "NO TRADE"

// Execution Trigger
bool trigger_buy  = (buy_score >= min_score) and (market_regime != 5) and (not is_trend_bear)
bool trigger_sell = (sell_score >= min_score) and (market_regime != 5) and (not is_trend_bull)

// Bar confirmation filter
bool confirmed_bar = exec_tf_only ? barstate.isconfirmed : true
bool final_buy  = trigger_buy and confirmed_bar
bool final_sell = trigger_sell and confirmed_bar

// Anti-Repetition Filter
var int last_trade_bar = 0
if (final_buy or final_sell) and (bar_index - last_trade_bar < 3)
    final_buy  := false
    final_sell := false

if final_buy or final_sell
    last_trade_bar := bar_index

// =============================================================================
// 9. DYNAMIC SL/TP ENGINE & TRADE MANAGEMENT
// =============================================================================
var int block_seq = 0
if final_buy or final_sell
    block_seq += 1

var float sig_entry = na
var float sig_sl    = na
var float sig_tp1   = na
var float sig_tp2   = na
var float sig_tp3   = na

if final_buy
    sig_entry := close
    float sl_distance = atr_val * atr_sl_mult
    sig_sl    := close - sl_distance
    sig_tp1   := close + (sl_distance * tp1_mult)
    sig_tp2   := close + (sl_distance * tp2_mult)
    sig_tp3   := close + (sl_distance * tp3_mult)
    
    string buy_label = "⚡ BUY [" + signal_qual + "]\nStrategy: " + active_strat + "\nScore: " + str.tostring(buy_score) + "/100\nEntry: " + str.tostring(sig_entry, "#.##") + "\nSL: " + str.tostring(sig_sl, "#.##") + "\nTP1: " + str.tostring(sig_tp1, "#.##") + "\nTP2: " + str.tostring(sig_tp2, "#.##") + "\nTP3: " + str.tostring(sig_tp3, "#.##")
    label.new(bar_index, low - (atr_val * 0.6), text=buy_label, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    
    // Dynamic JSON Webhook
    string json_payload = '{"version":"v6.0","symbol":"' + syminfo.ticker + '","signal":"BUY","entry":' + str.tostring(sig_entry) + ',"sl":' + str.tostring(sig_sl) + ',"tp1":' + str.tostring(sig_tp1) + ',"tp2":' + str.tostring(sig_tp2) + ',"tp3":' + str.tostring(sig_tp3) + ',"score":' + str.tostring(buy_score) + ',"regime":"' + regime_str + '","strategy":"' + active_strat + '","block":' + str.tostring(block_seq) + '}'
    alert(json_payload, alert.freq_once_per_bar_close)

if final_sell
    sig_entry := close
    float sl_distance = atr_val * atr_sl_mult
    sig_sl    := close + sl_distance
    sig_tp1   := close - (sl_distance * tp1_mult)
    sig_tp2   := close - (sl_distance * tp2_mult)
    sig_tp3   := close - (sl_distance * tp3_mult)
    
    string sell_label = "⚡ SELL [" + signal_qual + "]\nStrategy: " + active_strat + "\nScore: " + str.tostring(sell_score) + "/100\nEntry: " + str.tostring(sig_entry, "#.##") + "\nSL: " + str.tostring(sig_sl, "#.##") + "\nTP1: " + str.tostring(sig_tp1, "#.##") + "\nTP2: " + str.tostring(sig_tp2, "#.##") + "\nTP3: " + str.tostring(sig_tp3, "#.##")
    label.new(bar_index, high + (atr_val * 0.6), text=sell_label, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    
    // Dynamic JSON Webhook
    string json_payload = '{"version":"v6.0","symbol":"' + syminfo.ticker + '","signal":"SELL","entry":' + str.tostring(sig_entry) + ',"sl":' + str.tostring(sig_sl) + ',"tp1":' + str.tostring(sig_tp1) + ',"tp2":' + str.tostring(sig_tp2) + ',"tp3":' + str.tostring(sig_tp3) + ',"score":' + str.tostring(sell_score) + ',"regime":"' + regime_str + '","strategy":"' + active_strat + '","block":' + str.tostring(block_seq) + '}'
    alert(json_payload, alert.freq_once_per_bar_close)

// Visual EMA Ribbon
plot(show_ribbon ? ema_fast : na, "EMA Fast", color=color.blue, width=1)
plot(show_ribbon ? ema_mid : na,  "EMA Mid",  color=color.yellow, width=2)
plot(show_ribbon ? ema_slow : na, "EMA Slow", color=color.purple, width=2)

// =============================================================================
// 10. COMPACT HUD DASHBOARD TABLE
// =============================================================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 15), border_color=color.gray, border_width=1)

if show_table and barstate.islast
    table.cell(hud, 0, 0, "🏛️ INSTITUTIONAL ENGINE", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "METRIC / STATUS", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "Market Regime", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, regime_str, bgcolor=regime_col, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 2, "Active Strategy", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, active_strat, text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 3, "Signal Quality", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, signal_qual + " (" + str.tostring(dominant_score) + " pts)", text_color=dominant_score >= min_score ? color.green : color.silver, text_size=size.small)
    
    table.cell(hud, 0, 4, "HTF Trend Alignment", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, htf_bull ? "BULLISH (" + htf_tf + "m)" : (htf_bear ? "BEARISH (" + htf_tf + "m)" : "NEUTRAL"), text_color=htf_bull ? color.green : (htf_bear ? color.red : color.gray), text_size=size.small)
    
    table.cell(hud, 0, 5, "KNN Adaptive Pattern", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(math.round(knn_confidence, 1)) + "% Conf (" + str.tostring(knn_votes_bull) + "B / " + str.tostring(knn_votes_bear) + "S)", text_color=knn_confidence >= 60 ? color.green : color.orange, text_size=size.small)
    
    table.cell(hud, 0, 6, "Volume Pressure CVD", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, delta_bull ? "BUY DOMINANT" : "SELL DOMINANT", text_color=delta_bull ? color.green : color.red, text_size=size.small)
    
    table.cell(hud, 0, 7, "Risk & Repaint Status", text_color=color.silver, text_size=size.tiny)
    table.cell(hud, 1, 7, "REPAINT: ZERO (Confirmed)", bgcolor=color.new(color.teal, 30), text_color=color.white, text_size=size.tiny)

// Standard UI Alert Conditions
alertcondition(final_buy,  title="[Institutional v6] Confirmed BUY",  message="Institutional BUY Signal Triggered")
alertcondition(final_sell, title="[Institutional v6] Confirmed SELL", message="Institutional SELL Signal Triggered")
